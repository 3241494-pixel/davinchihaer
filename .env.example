# Скопируйте в .env.local и заполните значения.

# Telegram Bot API — отправка заявок (см. src/lib/telegram.ts).
# Без TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID заявки не уйдут в Telegram
# (если при этом не настроен RESEND_API_KEY — заявка не уйдёт никуда).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ID тем (message_thread_id) супергруппы — по одной на тип заявки.
# Если тема не задана — сообщение уходит в общий чат супергруппы, не падает.
# Как получить значения — см. инструкцию в конце ответа Claude по этапу 6.
# TELEGRAM_TOPIC_RETAIL=
# TELEGRAM_TOPIC_WHOLESALE=
# TELEGRAM_TOPIC_TRAINING=

# Email-дублирование заявок — опционально, включается наличием ключа.
# Отсутствие RESEND_API_KEY НЕ должно ломать отправку заявок (см. lib/email.ts).
# RESEND_API_KEY=
# LEADS_EMAIL_TO=
# LEADS_EMAIL_FROM=
